# Usado por `npm run build`
#
# Dominio publico del servicio backend en Railway
# (Railway > servicio backend > Settings > Networking > Public Domain).
#
# No usar el hostname *.railway.internal: solo resuelve dentro de la red privada
# de Railway y esta SPA hace los fetch desde el navegador del usuario.
VITE_API_URL=https://prueba-tecnica-publicardor-obio-production.up.railway.app
