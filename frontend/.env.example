# URL base del backend FastAPI que consume el frontend.
#
# Local:
#   VITE_API_URL=http://localhost:8000
#
# Railway (dominio publico del servicio backend — el que funciona desde el navegador):
#   VITE_API_URL=https://prueba-tecnica-publicardor-obio.up.railway.app
#
# Railway (red privada, solo servicio-a-servicio, NO desde el navegador):
#   VITE_API_URL=http://prueba-tecnica-publicardor-obio.railway.internal:8080
VITE_API_URL=http://localhost:8000
